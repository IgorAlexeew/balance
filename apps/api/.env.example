# ---- Обязательные ----
# SQLite-файл относительно apps/api/prisma/
DATABASE_URL="file:./dev.db"
# Публичный адрес фронтенда (в dev — Vite). Используется для редиректов OAuth,
# проверки Origin и флага Secure у cookie (https => Secure).
APP_URL="http://localhost:5173"
PORT=3001

# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TIMEZONE="Europe/Moscow"

# ---- Вход через Яндекс ID (https://oauth.yandex.ru/client/new) ----
# Redirect URI в настройках приложения: ${APP_URL}/api/auth/yandex/callback
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# ---- Демо-вход без пароля ----
# Только для локальной разработки: при NODE_ENV=production игнорируется.
DEMO_LOGIN=true

# ---- ИИ-анализ бюджета (любой OpenAI-совместимый Chat Completions API) ----
# Пусто — функция выключена. Пример: AI_API_URL="https://api.openai.com/v1"
AI_API_URL=""
AI_API_KEY=""
AI_MODEL=""
