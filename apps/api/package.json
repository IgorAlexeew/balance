{
  "name": "@balance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@balance/contracts": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/client": "~6.19.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "hono": "^4.13.12",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "prisma": "~6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
