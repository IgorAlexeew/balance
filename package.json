{
  "name": "balance",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "db:migrate": "pnpm --filter @balance/api db:migrate",
    "db:seed": "pnpm --filter @balance/api db:seed",
    "db:studio": "pnpm --filter @balance/api db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.6",
    "typescript": "~5.9.3"
  }
}
